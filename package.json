    "test:e2e": "npm run build && playwright test",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.0",
    "pdfkit": "^0.19.1",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.34.5"

{
  "name": "tip-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "validate:vakalar": "npx tsx scripts/validate-vakalar.ts",
    "validate:vakalar:json": "npx tsx scripts/validate-vakalar.ts --json",
    "pipeline:scan": "npx tsx scripts/scan-tests.ts",
    "pipeline:scan:json": "npx tsx scripts/scan-tests.ts --json",
    "pipeline:fill": "npx tsx scripts/fill-tests.ts",
    "pipeline:fill:dry": "npx tsx scripts/fill-tests.ts --dry",
    "pipeline:validate": "npx tsx scripts/validate-vakalar.ts",
    "pipeline:validate:json": "npx tsx scripts/validate-vakalar.ts --json",
    "pipeline:run": "npx tsx scripts/fill-tests.ts && npx tsx scripts/validate-vakalar.ts",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "next": "^16.3.0",
    "pdfkit": "^0.19.1",
    "prisma": "^5.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}

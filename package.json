{
  "name": "tip-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "db:migrate": "node scripts/standalone-migrate.mjs",
    "db:load-synthea": "npx tsx scripts/load-synthea.ts",

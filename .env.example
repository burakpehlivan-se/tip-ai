# ── Admin kimlik doğrulama ──
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password
ADMIN_SESSION_SECRET=long-random-secret-at-least-32-chars

# ── Öğrenci oturumu (opsiyonel — yoksa ADMIN_SESSION_SECRET kullanılır) ──
STUDENT_SESSION_SECRET=another-long-random-secret-at-least-32-chars

# ── Misafir deneme vakası (opsiyonel — yoksa ilk aktif vaka şablonu kullanılır) ──
GUEST_CASE_ID=

# ── Veritabanı (PostgreSQL) ──
# PostgreSQL, kullanıcı deposu geçişi için hazırlanmıştır. Runtime kimlik
# doğrulama cutover tamamlanana kadar JSON deposunu kullanır.
# Coolify'da ayrı bir "PostgreSQL" yönetilen veritabanı servisi bağlanmalıdır.
DATABASE_URL=postgresql://tip_ai:change-me@postgres:5432/tip_ai

# ── PostgreSQL auth geçiş gözlemi ──
# JSON auth davranışını değiştirmeden başarılı girişlerde PostgreSQL parity kaydı üretir.
# Cutover öncesi kısa süreli etkinleştirin; varsayılan kapalıdır.
AUTH_SHADOW_READ=0

# ── Admin kimlik doğrulama ──
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password
ADMIN_SESSION_SECRET=long-random-secret-at-least-32-chars

# ── Öğrenci oturumu ──
# ADMIN_SESSION_SECRET'tan ayrı tutulur; HMAC izolasyonu sağlar.
# Üretimde ayarlanması önerilir. Ayarlanmazsa ADMIN_SESSION_SECRET'e fallback eder
# (deprecated, log'da warn verir) ve izolasyon kalkar. En az 32 byte rastgele değer.
STUDENT_SESSION_SECRET=another-long-random-secret-at-least-32-chars

# ── Misafir deneme vakası (opsiyonel — yoksa ilk aktif vaka şablonu kullanılır) ──
GUEST_CASE_ID=

# ── Veritabanı (PostgreSQL) ──
# PostgreSQL, kullanıcı deposu geçişi için hazırlanmıştır. Runtime kimlik
# doğrulama cutover tamamlanana kadar JSON deposunu kullanır.
# Coolify'da ayrı bir "PostgreSQL" yönetilen veritabanı servisi bağlanmalıdır.
DATABASE_URL=postgresql://tip_ai:change-me@postgres:5432/tip_ai

# ── Runtime depo modu ──
# Tek bir bayrakla kullanıcı, vaka ve deneme depoları kontrol edilir.
# Varsayılan JSON'dir. Shadow-read gözlemi temiz tamamlanmadan postgres yapmayın.
# Rollback için json değerine dönüp yeniden deploy edin; iki depo arasında çift yazma yoktur.
STORE_MODE=json

# JSON canlı kaynakken PostgreSQL eşini yalnızca gözlem amacıyla okur (0/1).
STORE_SHADOW_READ=0

# PostgreSQL modunda her imzalı token sunucu tarafında doğrulanır ve çıkışta
# iptal edilir. Ayrı bir flag yoktur; auth_sessions migration'ı zorunludur.

# ── DeepSeek AI (cevap üretimi + serbest metin eşleştirme) ──
# OpenAI-uyumlu Chat Completions ucu. Anahtar yoksa AI özellikleri sessizce kapalıdır.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ── Admin kimlik doğrulama ──
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password
ADMIN_SESSION_SECRET=long-random-secret-at-least-32-chars

# ── Öğrenci oturumu ──
# ADMIN_SESSION_SECRET'tan ayrı tutulur; HMAC izolasyonu sağlar.
# Üretimde ayarlanması önerilir. Ayarlanmazsa ADMIN_SESSION_SECRET'e fallback eder
# (deprecated, log'da warn verir) ve izolasyon kalkar. En az 32 byte rastgele değer.
STUDENT_SESSION_SECRET=another-long-random-secret-at-least-32-chars

# ── Veritabanı (PostgreSQL) ──
# Tüm vaka verileri artık PostgreSQL üzerinden servis edilir (JSON modu kaldırıldı).
# Coolify'da ayrı bir "PostgreSQL" yönetilen veritabanı servisi bağlanmalıdır.
DATABASE_URL=postgresql://tip_ai:change-me@postgres:5432/tip_ai

# ── Runtime depo modu ──
# JSON modu kaldırıldı — sadece postgres desteklenir.
# Eski `json` değeri postgres'e fallback eder (warn) ve JSON dosyaları kullanılmaz.
STORE_MODE=postgres

# Shadow-read (json→postgres geçiş gözlemi): opsiyonel teşhis flag'i, varsayılan kapalı.
# STORE_MODE=postgres iken etkisizdir; yalnızca json birincil depo çalışırken anlamlıdır.
STORE_SHADOW_READ=0

# PostgreSQL modunda her imzalı token sunucu tarafında doğrulanır ve çıkışta
# iptal edilir. Ayrı bir flag yoktur; auth_sessions migration'ı zorunludur.

# ── Gemini AI (cevap üretimi + serbest metin eşleştirme) ──
# Gemini GenerateContent REST API. Anahtar yoksa AI özellikleri sessizce kapalıdır.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
